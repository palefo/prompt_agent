#: app.py:216
msgid "Use case one"
msgstr "Caso de uso um"

#: app.py:216
msgid "Use case two"
msgstr "Caso de uso dois"

#: app.py:227
msgid "Scenario one"
msgstr "Cenário um"

#: app.py:227
msgid "Scenario two"
msgstr "Cenário dois"

#: app.py:227
msgid "Scenario three"
msgstr "Cenário três"

#: app.py:295
msgid ""
"Languages must use the format 'code: Language name', e.g. 'es: Español' "
"or 'pt-BR: Português (Brasil)'."
msgstr ""
"Os idiomas devem usar o formato 'código: Nome do idioma', por exemplo "
"'es: Español' ou 'pt-BR: Português (Brasil)'."

#: app.py:300
msgid "At least one language is required."
msgstr "É necessário pelo menos um idioma."

#: app.py:302
msgid "Language codes must be unique."
msgstr "Os códigos de idioma não podem se repetir."

#: app.py:317
msgid "The three scenarios of a use case need different names."
msgstr "Os três cenários de um caso de uso precisam de nomes diferentes."

#: app.py:331
msgid "The two use cases need different titles."
msgstr "Os dois casos de uso precisam de títulos diferentes."

#: app.py:347
msgid "The completion URL must be a full link starting with https://"
msgstr "A URL de conclusão deve ser um link completo começando com https://"

#: app.py:361
msgid "Please enter your name."
msgstr "Por favor, informe seu nome."

#: app.py:363
msgid "Please enter a valid age."
msgstr "Por favor, informe uma idade válida."

#: app.py:365
msgid "Please select your gender."
msgstr "Por favor, selecione seu gênero."

#: app.py:367
msgid "Please select your community."
msgstr "Por favor, selecione sua comunidade."

#: app.py:385
msgid "This form has expired. Please reload the page and try again."
msgstr "Este formulário expirou. Recarregue a página e tente novamente."

#: app.py:463
msgid "Incorrect password."
msgstr "Senha incorreta."

#: app.py:501
msgid "Study ID and header are required."
msgstr "O ID do estudo e o cabeçalho são obrigatórios."

#: app.py:504
msgid ""
"The study ID may only use lowercase letters, numbers, - and _, and cannot"
" be a reserved word such as admin or app."
msgstr ""
"O ID do estudo só pode ter letras minúsculas, números, - e _, e não pode "
"ser uma palavra reservada como admin ou app."

#: app.py:508
msgid "This study no longer exists."
msgstr "Este estudo não existe mais."

#: app.py:511
msgid ""
"A study with this ID already exists. Choose another ID or edit the "
"existing study."
msgstr ""
"Já existe um estudo com este ID. Escolha outro ID ou edite o estudo "
"existente."

#: app.py:544
msgid "Please complete every field."
msgstr "Por favor, preencha todos os campos."

#: app.py:546
msgid "Upload all six study images."
msgstr "Envie as seis imagens do estudo."

#: app.py:548
msgid "Upload the participant information sheet as a PDF."
msgstr "Envie a folha de informações para participantes em PDF."

#: app.py:550
msgid "The participant information sheet must be a PDF."
msgstr "A folha de informações para participantes deve ser um PDF."

#: app.py:570
#, python-format
msgid "Study '%(study)s' was updated."
msgstr "O estudo '%(study)s' foi atualizado."

#: app.py:572
#, python-format
msgid "Study '%(study)s' was created."
msgstr "O estudo '%(study)s' foi criado."

#: app.py:606
#, python-format
msgid "Deleted the response of %(user)s."
msgstr "A resposta de %(user)s foi excluída."

#: app.py:644
msgid "Please enter your Prolific ID and consent to participate."
msgstr ""
"Por favor, informe seu ID do Prolific e dê seu consentimento para "
"participar."

#: app.py:650
msgid "Please check your Prolific ID."
msgstr "Por favor, verifique seu ID do Prolific."

#: app.py:659
msgid "This Prolific ID has already been used."
msgstr "Este ID do Prolific já foi usado."

#: app.py:817
msgid "Sorry, the assistant could not reply just now. Please press Send again."
msgstr ""
"Desculpe, o assistente não conseguiu responder agora. Clique em Enviar "
"novamente."

#: app.py:843
msgid ""
"Sorry, the assistant is not available right now. Please reload the page "
"in a moment."
msgstr ""
"Desculpe, o assistente não está disponível no momento. Recarregue a "
"página daqui a pouco."

#: app.py:885
msgid "Something is not right"
msgstr "Algo não está certo"

#: app.py:886
msgid "Please go back and try again."
msgstr "Volte e tente novamente."

#: app.py:892
msgid "Page not found"
msgstr "Página não encontrada"

#: app.py:893
msgid "We could not find this page. Please check the link you were given."
msgstr "Não encontramos esta página. Verifique o link que você recebeu."

#: app.py:899
msgid "Upload too large"
msgstr "Arquivos grandes demais"

#: app.py:900
#, python-format
msgid ""
"The files are too large (%(size)s MB in total at most). Please use "
"smaller images."
msgstr ""
"Os arquivos são grandes demais (no máximo %(size)s MB no total). Use "
"imagens menores."

#: app.py:907
msgid "Something went wrong"
msgstr "Algo deu errado"

#: app.py:908
msgid "Please try again in a moment."
msgstr "Tente novamente daqui a pouco."

