# Copy to .env and fill in the blanks:  cp .env.example .env
# Never commit .env.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public hostname. Caddy gets a Let's Encrypt certificate for it automatically
# (DNS must point at this server and ports 80/443 must be open).
# Use "localhost" for a local test (self-signed certificate).
DOMAIN=futures.conversational-care.ai
# Optional folder with a static landing page (index.html + assets) served at "/".
# Leave empty to show the app's own home page at "/".
LANDING_DIR=
# Host folder for everything persistent: database, study files, certificates.
DATA_DIR=./data

# ── App ──────────────────────────────────────────────────────────────────────
# Long random string that signs session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Password for /admin (study builder and responses).
ADMIN_PASSWORD=
# Studies shipped with the code that are copied into DATA_DIR/studies on first
# start (comma-separated folder names). Existing studies are never overwritten.
SEED_STUDIES=south_asia

# ── Database (PostgreSQL container) ──────────────────────────────────────────
POSTGRES_DB=futures
POSTGRES_USER=futures
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
# Optional: use an external PostgreSQL instead of the container.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM ──────────────────────────────────────────────────────────────────────
# true  → Azure OpenAI (AZURE_OPENAI_* below)
# false → OpenAI API (OPENAI_API_KEY)
USE_AZURE=true
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Name of the model deployment in the Azure resource
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Optional tuning ──────────────────────────────────────────────────────────
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=8
# LLM_TIMEOUT=60
# MAX_UPLOAD_MB=50
# SESSION_HOURS=24
# LOG_LEVEL=INFO
